# Pods/

# ---------------------------------------------------------------------------
# Added when this project moved into full-instructions, 2026-08-29.
#
# Code-signing material. NONE of this is currently in the tree: signing
# identities live in the macOS Keychain and provisioning profiles in
# ~/Library/MobileDevice/Provisioning Profiles/, neither of which Xcode keeps
# in the project. These patterns exist so that a stray export can never be
# committed by accident.
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.pem
*.key
*.keystore
ExportOptions.plist

# Local signing/config overrides, if the placeholders below are ever adopted.
Signing.xcconfig
Local.xcconfig
*.local.xcconfig

# Build output and per-user Xcode state.
build/
DerivedData/
*.ipa
*.dSYM.zip
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# CocoaPods caches. Pods/ ITSELF IS COMMITTED, deliberately: upstream tracks it
# (2,472 files) and `pod install` cannot be relied on to reproduce a 2016-era
# dependency set. Do not add Pods/ here.
Pods/.build/
