CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "${PODS_CONFIGURATION_BUILD_DIR}/AttributedMarkdown" "${PODS_CONFIGURATION_BUILD_DIR}/CGFloatType" "${PODS_CONFIGURATION_BUILD_DIR}/CocoaLumberjack" "${PODS_CONFIGURATION_BUILD_DIR}/FXKeychain" "${PODS_CONFIGURATION_BUILD_DIR}/LGBluetooth" "${PODS_CONFIGURATION_BUILD_DIR}/NSJSONSerialization-NSNullRemoval" "${PODS_CONFIGURATION_BUILD_DIR}/SHSProtoBuf" "${PODS_CONFIGURATION_BUILD_DIR}/SORelativeDateTransformer" "${PODS_CONFIGURATION_BUILD_DIR}/SenseKit" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation" "${PODS_CONFIGURATION_BUILD_DIR}/iOSDFULibrary"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking/AFNetworking.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/AttributedMarkdown/AttributedMarkdown.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CGFloatType/CGFloatType.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CocoaLumberjack/CocoaLumberjack.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FXKeychain/FXKeychain.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/LGBluetooth/LGBluetooth.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/NSJSONSerialization-NSNullRemoval/NSJSONSerialization_NSNullRemoval.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SHSProtoBuf/ProtocolBuffers.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SORelativeDateTransformer/SORelativeDateTransformer.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SenseKit/SenseKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation/ZIPFoundation.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/iOSDFULibrary/NordicDFU.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks' '@executable_path/../../Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/AttributedMarkdown/AttributedMarkdown.framework/Headers" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/AttributedMarkdown"
OTHER_LDFLAGS = $(inherited) -framework "AFNetworking" -framework "AttributedMarkdown" -framework "CGFloatType" -framework "CocoaLumberjack" -framework "CoreBluetooth" -framework "CoreText" -framework "FXKeychain" -framework "Foundation" -framework "LGBluetooth" -framework "NSJSONSerialization_NSNullRemoval" -framework "NordicDFU" -framework "ProtocolBuffers" -framework "SORelativeDateTransformer" -framework "Security" -framework "SenseKit" -framework "UIKit" -framework "ZIPFoundation"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "-F${PODS_CONFIGURATION_BUILD_DIR}/AttributedMarkdown" "-F${PODS_CONFIGURATION_BUILD_DIR}/CGFloatType" "-F${PODS_CONFIGURATION_BUILD_DIR}/CocoaLumberjack" "-F${PODS_CONFIGURATION_BUILD_DIR}/FXKeychain" "-F${PODS_CONFIGURATION_BUILD_DIR}/LGBluetooth" "-F${PODS_CONFIGURATION_BUILD_DIR}/NSJSONSerialization-NSNullRemoval" "-F${PODS_CONFIGURATION_BUILD_DIR}/SHSProtoBuf" "-F${PODS_CONFIGURATION_BUILD_DIR}/SORelativeDateTransformer" "-F${PODS_CONFIGURATION_BUILD_DIR}/SenseKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation" "-F${PODS_CONFIGURATION_BUILD_DIR}/iOSDFULibrary"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
WARNING_CFLAGS = $(inherited) -Wno-missing-prototypes -Wno-format
