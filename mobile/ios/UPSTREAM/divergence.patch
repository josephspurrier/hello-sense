+    // which iOS does not reliably fetch, and the advertising packet itself
+    // carries nothing but the name. SENSense -matchesDeviceId: is what then
+    // decides whether this is the Sense paired to the account.
+    NSString* localName = advertisement[CBAdvertisementDataLocalNameKey] ?: [peripheral name];
+    return [localName hasPrefix:kSENSenseNamePrefix];
