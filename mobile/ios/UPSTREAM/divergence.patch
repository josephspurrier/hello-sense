+    NSDictionary* advertisement = [peripheral advertisingData];
+    CBUUID* serviceId = [CBUUID UUIDWithString:kSENSenseServiceID];
+
+    if ([advertisement[CBAdvertisementDataServiceUUIDsKey] containsObject:serviceId]) {
+        return YES;
+    }
+
+    // the service data is keyed by the 16 bit form of the same service, so a
+    // Sense whose 128 bit UUID landed in the scan response is still identified
