+    for (CBUUID* uuid in serviceData) {
+        NSString* uuidString = [[uuid UUIDString] uppercaseString];
+        if ([uuidString isEqualToString:kSENSenseServiceDataId]
+            || [uuidString hasPrefix:[@"0000" stringByAppendingString:kSENSenseServiceDataId]]) {
