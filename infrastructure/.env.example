# Copy to .env and edit. `.env` is gitignored; never commit real values.
#
#     cp .env.example .env
#
# Every value below has a working default in docker-compose.yml, so an empty
# .env still starts. The ones you must think about are POSTGRES_PASSWORD and
# the APNS block.

# ---------------------------------------------------------------- project ---
# The Compose project name decides the volume name. `hello-orb` reuses the
# existing hello-orb_pgdata volume, which is what you want when migrating a
# running deployment. Change it only for a genuinely separate instance, and
# understand that doing so starts from an EMPTY database.
COMPOSE_PROJECT_NAME=hello-orb

# ------------------------------------------------------------------ build ---
# orb, orb-algo and sense-server all build from source in THIS directory, so
# there is nothing to configure for them.
#
# The one exception is the suripu fat jar: 77 MB of Hello's build output, not
# ours to redistribute, so it stays outside the repository and is pulled in as
# a named build context. Point this at wherever you have it. See README.
SURIPU_JAR_DIR=../../infrastructure/suripu-app/target
SURIPU_JAR_NAME=suripu-app-0.6.0-SNAPSHOT.jar

# ---------------------------------------------------------------- postgres ---
POSTGRES_USER=hello
POSTGRES_PASSWORD=hello
POSTGRES_DB=orb
# Published on the host. Set to 127.0.0.1:5432 to refuse remote connections.
POSTGRES_PUBLISH=127.0.0.1:5432

# --------------------------------------------------------------------- orb ---
# The device edge and the app API, each split into a port and an optional bind
# address.
#
# The port is also what sense-server puts in its upstream URL, which is why it
# must stay a bare number. Put the address in the BIND_IP variable instead.
# These were one variable each until 2026-08-29, and setting the edge one to
# "127.0.0.1:8081" produced "http://127.0.0.1:127.0.0.1:8081" in that URL, with
# sense-server starting up and looking healthy while every device request
# failed.
ORB_EDGE_PORT=8081
ORB_API_PORT=9999

# Empty publishes on all interfaces, which is what a LAN deployment wants: the
# iPhone talks to the app API directly.
#
# On an internet-facing host set BOTH to 127.0.0.1. Caddy reaches orb by service
# name over the Compose network, and sense-server reaches the edge over the
# host's loopback, so neither port needs to be on a public interface. Nothing
# then depends on the firewall being right about ports 8081 and 9999.
ORB_EDGE_BIND_IP=
ORB_API_BIND_IP=

# Apple push. Leave APNS_KEY_FILE empty and push is simply off; orb logs
# "push disabled" and everything else works.
#
# The .p8 belongs in ./secrets/, which is gitignored. It must be readable by
# uid 10001 inside the container:
#
#     chown 10001 secrets/AuthKey_XXXXXXXXXX.p8 && chmod 600 secrets/*.p8
#
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM=
APNS_TOPIC=

# Extra flags appended to orb's command line. Two you may want:
#   -apns-production   use the production APNs host. A development or TestFlight
#                      build of the app needs the SANDBOX host, which is the
#                      default, so leave this off unless the app is from the
#                      App Store.
#   -debug             verbose logging, including the device's file manifest.
ORB_EXTRA_FLAGS=

# ---------------------------------------------------------------- orb-algo ---
# Empty by default, which reproduces today's behaviour exactly. The JVM
# currently sits around 400 MB RSS. -Xmx256m or -XX:MaxRAMPercentage=25 will
# cut that, but neither has been tested against a real overnight timeline, so
# capping it is a deliberate choice rather than a default.
JAVA_OPTS=

# ------------------------------------------------------------ sense-server ---
# Linux only. On macOS this runs on the host instead; see README.
#
# Certificate and key for the device-facing TLS listener, in ./secrets/.
SENSE_CERT_FILE=server.crt
SENSE_KEY_FILE=server.key

# ACME http-01 webroot, for issuing a Let's Encrypt certificate for the app API
# while the device keeps port 80. Empty means off. Set to /acme (the path
# inside the container, not on the host) once certbot is writing into ./acme.
# See README, "A certificate for the app API".
SENSE_ACME_WEBROOT=

# ---------------------------------------------------------------------- ota ---
# Both empty means the shipped defaults: offers only between 02:00 and 05:00 in
# the device's local time, and only to a device that has been up 20 minutes.
#
# For a supervised test, something like ORB_OTA_WINDOW=14-18 and
# ORB_OTA_MIN_UPTIME=5m makes iterating bearable. Put them back afterwards; orb
# warns on every start while they are loosened.
ORB_OTA_WINDOW=
ORB_OTA_MIN_UPTIME=

# ------------------------------------------------------------------ public ---
# Only used with ORB_PUBLIC=1, which adds Caddy in front of the app API.
#
# APP_DOMAIN must match the certificate in /etc/letsencrypt, because the
# Caddyfile derives both the site address and the certificate paths from it.
# There is no default: an empty domain would silently produce a listener that
# matches nothing.
APP_DOMAIN=
APP_PUBLISH=8443

# ------------------------------------------------------------------- misc ---
# Timezone for the orb container. Affects its log timestamps and the ISO week
# that deduplicates the weekly pill-battery push, and nothing else: sleep dates
# come from the device's own UTC offset. UTC is the sane server default; set
# your local zone if you want logs you can read against a wall clock.
TZ=UTC
