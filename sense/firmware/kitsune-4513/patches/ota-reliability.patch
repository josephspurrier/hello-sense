+#define APP_IMG_FLASH_OFFSET 0x0100A000
+static bool _running_image_is_new(void) {
+    int newidx = _McuImageGetNewIndex();
+    char name[] = "/sys/mcuimg0.bin";
+    SlFsFileInfo_t info;
+    SHA1_CTX ctx;
+    unsigned char sha[SHA1_SIZE];
+    if (newidx < IMG_ACT_USER1 || newidx >= NUM_IMAGES) return false;
+    name[11] = (char)('1' + newidx); /* mcuimg2 for USER1, mcuimg3 for USER2 */
+    memset(&info, 0, sizeof(info));
+    if (sl_FsGetInfo((unsigned char*)name, 0, &info) != 0 || info.FileLen == 0) return false;
+    SHA1_Init(&ctx);
+    SHA1_Update(&ctx, (unsigned char*)APP_IMG_FLASH_OFFSET, info.FileLen);
+    SHA1_Final(sha, &ctx);
+    return memcmp(sha, sBootInfo.sha[newidx], SHA1_SIZE) == 0;
+}
