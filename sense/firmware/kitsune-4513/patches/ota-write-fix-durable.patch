+/* Verify the boot record against REAL flash: the live NWP answers reads from
+   cache, so the only honest check is stop -> start (fresh NWP) -> read.
+   Rewrites and retries if the record did not stick. One shared copy: the
+   three reset sites cannot afford triplicated code, the image is near the
+   link limit. */
+static void _commit_boot_record_durably(void) {
+	sBootInfo_t chk;
+	_i32 rv;
+	int t;
+	for( t = 0; t < 3; ++t ) {
+		rv = sl_Stop(30000);
+		sl_Start(NULL, NULL, NULL);
+		memset(&chk, 0, sizeof(chk));
+		rv = _ReadBootInfo(&chk);
+		LOGI("armchk2 t%d rd %d st %x img %d\n", t, rv, chk.ulImgStatus, chk.ucActiveImg);
+		if( rv >= 0 && chk.ulImgStatus == sBootInfo.ulImgStatus
+				&& chk.ucActiveImg == sBootInfo.ucActiveImg ) {
+			break;
+		}
+		LOGE("boot record not durable, rewriting\n");
+		_WriteBootInfo(&sBootInfo);
+		vTaskDelay(500);
+	}
+	sl_Stop(30000);
+	vTaskDelay(200);
+}
